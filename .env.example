# ==============================================================================
# SEPA/VCP Trading Terminal — Configuração Local (100% Gratuito)
# Copia este ficheiro para ".env" na raiz do projeto para personalizar.
# ==============================================================================

# --- Servidor Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SQLITE_DB_PATH=backend/data/trading_terminal.db

# Password opcional para proteger o site quando publicado online (deixa vazio em localhost)
APP_ACCESS_PASSWORD=

# --- Provedor de IA (Briefings de Notícias & Visão de Gráficos) ---
# Opções: auto | gemini | ollama | none
AI_PROVIDER=auto

# Google Gemini API (Free Tier - obter grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local (100% offline/gratuito - https://ollama.com)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen2.5-vl

# --- Alertas Gratuitos (Telemóvel / Desktop — Opcional) ---
# Telegram Bot: cria grátis no @BotFather e obtém o chat_id no @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Definições do Canal -> Integrações -> Webhooks -> Copiar URL
DISCORD_WEBHOOK_URL=

# --- Cache TTL (segundos) ---
CACHE_TTL_PRICES=600
CACHE_TTL_NEWS=900
CACHE_TTL_SCAN=21600
CACHE_TTL_FUNDAMENTALS=86400
CACHE_TTL_AI=21600

# --- Scheduler (Background Auto-Refresh) ---
SCHEDULER_ENABLED=true
SCHEDULER_MACRO_MINUTES=15
SCHEDULER_PAPER_MINUTES=10
SCHEDULER_SCAN_HOURS=6

# --- Gestão de Risco (Defaults) ---
DEFAULT_CAPITAL_EUR=100.0
DEFAULT_STOP_LOSS_PCT=6.0
MAX_STOP_LOSS_PCT=7.0
